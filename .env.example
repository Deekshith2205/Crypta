# ==============================================================================
# QuantumShield Enterprise Environment Configuration Template
# PLACEHOLDERS ONLY — NEVER COMMIT REAL SECRETS OR PRODUCTION API KEYS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server & Network Interface
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Allowed Origins (comma-separated URLs, no wildcards in production)
QS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Maximum HTTP request body size in bytes (default: 5242880 = 5 MiB)
QS_MAX_REQUEST_SIZE_BYTES=5242880

# Optional API Authentication Key (when unset, local development mode is unauthenticated)
QS_API_KEY=

# Trusted Reverse Proxy Count for X-Forwarded-For resolution (default: 0)
QS_TRUSTED_PROXY_COUNT=0

# Data Storage Directory for SQLite audit ledger and keys (default: <repo>/data)
QS_DATA_DIR=

# ------------------------------------------------------------------------------
# 2. Scanner & Network Safety Allowlist
# ------------------------------------------------------------------------------
# Allowed TCP scan ports for external TLS inspection (comma-separated integers)
QS_ALLOWED_SCAN_PORTS=443,8443,993,995,465

# Optional OpenSSL Binary Path override for TLS 1.3 KeyShare inspection
QUANTUMSHIELD_OPENSSL_PATH=

# ------------------------------------------------------------------------------
# 3. Security Rate Limiting (Token Bucket & Sliding Window)
# ------------------------------------------------------------------------------
# Live scan endpoint limits (default: 10 requests per 60.0s window)
QS_RATE_LIMIT_SCAN=10
QS_RATE_LIMIT_SCAN_WINDOW=60.0

# Artifact upload scan limits (default: 5 uploads per 60.0s window)
QS_RATE_LIMIT_UPLOAD=5
QS_RATE_LIMIT_UPLOAD_WINDOW=60.0

# AI intelligence endpoint limits (default: 5 requests per 60.0s window)
QS_RATE_LIMIT_AI=5
QS_RATE_LIMIT_AI_WINDOW=60.0

# ------------------------------------------------------------------------------
# 4. Cryptographic Audit Ledger & Tamper-Evident Checkpoints
# ------------------------------------------------------------------------------
# HMAC-SHA256 Audit Signing Key override (generated/stored in data/ if unset)
QS_AUDIT_SIGNING_KEY=

# Enforce external checkpointing on assessment storage (fail-closed if unavailable)
QS_REQUIRE_EXTERNAL_CHECKPOINT=false

# Remote HTTP Checkpoint Service URL (e.g., https://checkpoint.internal.bank/api/v1/anchor)
QS_EXTERNAL_CHECKPOINT_URL=

# Shared Secret Key for HMAC signature on external HTTP checkpoint webhook
QS_EXTERNAL_CHECKPOINT_KEY=

# ------------------------------------------------------------------------------
# 5. AI-Powered Quantum Readiness Intelligence Layer
# ------------------------------------------------------------------------------
# AI Provider Selection:
# Options: "none" (default/disabled), "mock" (offline testing), "gemini", "openai", "anthropic"
AI_PROVIDER=none

# Google Gemini API Key (when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Model Identifier Overrides
# Defaults:
# - Gemini: gemini-1.5-flash
# - OpenAI: gpt-4o-mini
# - Anthropic: claude-3-5-haiku-20241022
AI_MODEL=

# AI Service Limits & Timeouts
AI_TIMEOUT_SECONDS=12.0
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_INPUT_LENGTH=4000

# Enable Deterministic Mock AI Provider for Offline Testing
AI_MOCK_ENABLED=false

# Daily AI Usage & Budget Limits (process-local tracking)
QS_AI_DAILY_TOKEN_BUDGET=100000
QS_AI_DAILY_COST_BUDGET_USD=5.00
QS_AI_ESTIMATED_COST_PER_1K_TOKENS=0.002

# ------------------------------------------------------------------------------
# 6. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Backend API Base URL (empty string defaults to same-origin with fallback)
VITE_API_URL=
